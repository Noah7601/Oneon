<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels.Pages"
             xmlns:app="using:Filee.App.ViewModels"
             x:Class="Filee.App.Views.Pages.HomePage"
             x:DataType="vm:HomePageViewModel">
  <UserControl.Styles>
    <Style Selector="Border#DropZone">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.2" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="QuinticEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#DropZone.over">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="RenderTransform" Value="scale(1.005)" />
    </Style>
    <Style Selector="Rectangle#DropOutline">
      <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Path#DropArrow">
      <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border#DropZone.over Path#DropArrow">
      <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border#DropZone.over Rectangle#DropOutline">
      <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="PathIcon.chevron">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <Style Selector="PathIcon.chevron.open">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="24">
    <TextBlock Classes="h1" Text="{DynamicResource home.title}" />

    <!-- macOS without Accessibility permission: the drag gesture can't work yet. Gone once it is given. -->
    <Border IsVisible="{Binding NeedsAccessibility}" Background="{DynamicResource AccentFaintBrush}"
            BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1" CornerRadius="{DynamicResource SoftRadius}" Padding="16,12">
      <DockPanel>
        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" Classes="accent"
                Content="{DynamicResource triggers.open_accessibility}" Command="{Binding OpenAccessibilityCommand}" />
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{DynamicResource home.accessibility_needed}" />
      </DockPanel>
    </Border>

    <!-- Drop zone: files dropped here open the donut toolbar at the cursor. -->
    <!-- Drop zone: dashed outline like a Finder drop target; files dropped here open the donut toolbar. -->
    <Border x:Name="DropZone" DragDrop.AllowDrop="True" MinHeight="180"
            Background="Transparent" CornerRadius="{DynamicResource SoftRadiusLarge}" Padding="28">
      <Panel>
        <Rectangle x:Name="DropOutline" StrokeThickness="1.5" StrokeDashArray="2.5,2" StrokeLineCap="Round"
                   RadiusX="16" RadiusY="16" Margin="-28" IsHitTestVisible="False" />
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <Path x:Name="DropArrow" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"
              StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
              Data="M12,3 V14 M7.5,9.5 L12,14 L16.5,9.5 M4,15 V19.5 H20 V15" />
        <TextBlock Classes="h2" HorizontalAlignment="Center" Text="{DynamicResource home.drop_title}" />
        <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                   Text="{Binding DropHint}" />
      </StackPanel>
      </Panel>
    </Border>

    <!-- Recent conversions -->
    <StackPanel Spacing="12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="link" Content="{DynamicResource home.clear_history}" Command="{Binding ClearHistoryCommand}" />
        <TextBlock Classes="h2" VerticalAlignment="Center" Text="{DynamicResource home.recent}" />
      </DockPanel>
      <Border Classes="card" IsVisible="{Binding IsEmpty}" Padding="16,14">
        <TextBlock Classes="muted" Text="{DynamicResource home.recent_empty}" />
      </Border>
      <Border Classes="group" IsVisible="{Binding !IsEmpty}">
      <ItemsControl Classes="grouped" ItemsSource="{Binding History}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="0" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HistoryItemViewModel">
            <Border Classes="row">
              <StackPanel Spacing="8">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Command="{Binding OpenFolderCommand}" IsVisible="{Binding HasOutputs}" Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Folder}" />
                      <TextBlock Text="{DynamicResource home.open_folder}" />
                    </StackPanel>
                  </Button>
                  <Border DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,12,0">
                    <Panel>
                      <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Check}" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding !HasErrors}" />
                      <PathIcon Width="15" Height="15" Data="{StaticResource Icon.Alert}" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding HasErrors}" />
                    </Panel>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="caption" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                      <TextBlock Classes="caption" Text="·" />
                      <TextBlock Classes="caption" Text="{Binding Time}" />
                    </StackPanel>
                  </StackPanel>
                </DockPanel>

                <!-- Failed files: the list on demand, and converting them again -->
                <DockPanel IsVisible="{Binding HasFailures}" Margin="36,0,0,0">
                  <Button DockPanel.Dock="Right" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Refresh}" />
                      <TextBlock Text="{DynamicResource common.retry}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="ghost" Command="{Binding ToggleFailuresCommand}" Padding="6,4" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Classes="chevron" Classes.open="{Binding ShowFailures}" Width="12" Height="12"
                                Data="{StaticResource Icon.ChevronRight}" />
                      <TextBlock Classes="caption danger" Text="{Binding FailureSummary}" />
                    </StackPanel>
                  </Button>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Failures}" IsVisible="{Binding ShowFailures}" Margin="42,0,0,2">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="app:FailureItem">
                      <StackPanel>
                        <SelectableTextBlock Classes="caption" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                        <SelectableTextBlock Classes="caption danger" Text="{Binding Reason}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
