<!--
  theOdrop Apple-like look: neutral system greys, system blue, calm motion, macOS type scale.
  Colours that depend on light/dark live in ThemeDictionaries below; the accent colour, corner radii and
  the UI font are written at runtime by ThemeService (so users can customise them).
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Filee.App.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PageBrush" Color="#F2F5F5F7" />
          <SolidColorBrush x:Key="WindowGlassBrush" Color="#EDFAFAFA" />
          <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#A6FFFFFF" />
          <SolidColorBrush x:Key="GlassSurfaceStrongBrush" Color="#E8FFFFFF" />
          <SolidColorBrush x:Key="GlassHighlightBrush" Color="#F2FFFFFF" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#E6FFFFFF" />
          <SolidColorBrush x:Key="SurfaceAltBrush" Color="#8FFFFFFF" />
          <SolidColorBrush x:Key="SubtleBorderBrush" Color="#2E3C3C43" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#D9000000" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#993C3C43" />
          <SolidColorBrush x:Key="DangerBrush" Color="#FF3B30" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#248A3D" />
          <SolidColorBrush x:Key="WarningBrush" Color="#C93400" />
          <BoxShadows x:Key="CardShadow">0 1 2 0 #0F000000, 0 4 14 0 #0D000000</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PageBrush" Color="#F21C1C1E" />
          <SolidColorBrush x:Key="WindowGlassBrush" Color="#E61E1E20" />
          <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#662C2C2E" />
          <SolidColorBrush x:Key="GlassSurfaceStrongBrush" Color="#D32C2C2E" />
          <SolidColorBrush x:Key="GlassHighlightBrush" Color="#28FFFFFF" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#D12C2C2E" />
          <SolidColorBrush x:Key="SurfaceAltBrush" Color="#713A3A3C" />
          <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1FFFFFFF" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#D9FFFFFF" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99EBEBF5" />
          <SolidColorBrush x:Key="DangerBrush" Color="#FF453A" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#30D158" />
          <SolidColorBrush x:Key="WarningBrush" Color="#FF9F0A" />
          <BoxShadows x:Key="CardShadow">0 1 2 0 #33000000, 0 6 18 0 #40000000</BoxShadows>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Defaults; ThemeService overwrites these at startup. -->
      <SolidColorBrush x:Key="AccentBrush" Color="#007AFF" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E007AFF" />
      <SolidColorBrush x:Key="AccentFaintBrush" Color="#17007AFF" />
      <SolidColorBrush x:Key="AccentStrongBrush" Color="#005CBF" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
      <CornerRadius x:Key="SoftRadius">12</CornerRadius>
      <CornerRadius x:Key="SoftRadiusSmall">7</CornerRadius>
      <CornerRadius x:Key="SoftRadiusLarge">16</CornerRadius>
      <FontFamily x:Key="AppFontFamily">SF Pro Text, SF Pro Display, Apple SD Gothic Neo, Noto Sans, sans-serif</FontFamily>

      <!-- Calm ease-out (no overshoot), closer to macOS motion. -->
      <QuinticEaseOut x:Key="SoftEase" />
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ───────── Windows & typography ───────── -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource PageBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- ───────── Cards ───────── -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadius}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="Cursor" Value="SizeAll" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="{StaticResource SoftEase}" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.chip:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
    <Setter Property="RenderTransform" Value="scale(1.02)" />
  </Style>

  <!-- Badge for engine status etc. -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
  </Style>
  <Style Selector="Border.badge.ok">
    <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
  </Style>

  <!-- ───────── Buttons: soft corners and a springy press ───────── -->
  <Style Selector="Button, ToggleButton, RepeatButton">
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadiusSmall}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="{StaticResource SoftEase}" />
        <BrushTransition Property="Background" Duration="0:0:0.14" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pressed, ToggleButton:pressed">
    <Setter Property="RenderTransform" Value="scale(0.98)" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- Small links at the bottom of the navigation (GitHub, Sponsor) -->
  <Style Selector="Button.navlink">
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.navlink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <!-- Text-only accent button (e.g. "Clear"), like macOS/iOS plain buttons -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ProgressBar.soft">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
  </Style>

  <Style Selector="TextBox, ComboBox, NumericUpDown">
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadiusSmall}" />
  </Style>

  <!-- ───────── Navigation list ───────── -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadiusSmall}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="{StaticResource SoftEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <!-- Generic rounded list items (profiles, presets) -->
  <Style Selector="ListBox.soft">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.soft ListBoxItem">
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadiusSmall}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="ListBox.soft ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <!-- ───────── Grouped list (macOS Settings style): one rounded box, hairline between rows ───────── -->
  <Style Selector="Border.group">
    <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadius}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.row">
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="ItemsControl.grouped ContentPresenter:nth-child(1) > Border.row">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- ───────── Donut control colours ───────── -->
  <Style Selector="c|DonutMenu">
    <Setter Property="SliceBrush" Value="{DynamicResource GlassSurfaceStrongBrush}" />
    <Setter Property="SliceBorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="CenterBrush" Value="{DynamicResource GlassSurfaceStrongBrush}" />
    <Setter Property="AccentBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="OnAccentBrush" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="SecondaryForeground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="DangerBrush" Value="{DynamicResource DangerBrush}" />
    <Setter Property="SuccessBrush" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <!-- ───────── Page content fade-in (keyframes can't animate RenderTransform, so Margin slides) ───────── -->
  <Style Selector="ContentControl.page > :is(Control)">
    <Style.Animations>
      <Animation Duration="0:0:0.22" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="Margin" Value="0,4,0,-4" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="Margin" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ───────── Reduced motion: remove every transition and animation above ───────── -->
  <Style Selector="Window.reduced-motion :is(Button), Window.reduced-motion :is(ToggleButton), Window.reduced-motion Border.chip, Window.reduced-motion Border#DropZone, Window.reduced-motion ListBoxItem">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
  <Style Selector="Window.reduced-motion Button:pressed, Window.reduced-motion ToggleButton:pressed, Window.reduced-motion Border.chip:pointerover, Window.reduced-motion Border#DropZone.over, Window.reduced-motion ListBox.nav ListBoxItem:pointerover">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Window.reduced-motion ContentControl.page > :is(Control)">
    <Style.Animations>
      <Animation Duration="0:0:0.001" FillMode="Forward">
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
